{
  "$schema": "./node_modules/oxlint/configuration_schema.json",
  "extends": ["./node_modules/@pentaho/uikit-config/oxlint/strict.json"],
  "rules": {
    "no-restricted-imports": [
      "error",
      {
        "patterns": [
          "@pentaho/*/*",
          "@mui/material",
          "@mui/base/*",
          "@phosphor-icons/react"
        ],
        "paths": [
          "..",
          "../..",
          {
            "name": "react",
            "importNames": ["default"],
            "message": "React namespace import not allowed"
          }
        ]
      }
    ]
  },
  "overrides": [
    {
      "files": [
        "**/*.stories.tsx",
        "**/stories/**/*",
        "**/*.test.tsx",
        "**/*.spec.ts",
        "apps/*/src/**/*",
        "**/test/**/*"
      ],
      "rules": {
        "no-alert": "off",
        "no-console": "off",
        "import/default": "off"
      }
    },
    {
      "files": ["**/*.stories.tsx"],
      "rules": {
        "react-hooks/rules-of-hooks": "off"
      }
    }
  ]
}
