{
  "extends": "./tsconfig.build.json",
  "compilerOptions": {
    "allowImportingTsExtensions": true
  },
  "include": [
    ".config/*.ts",
    "*.config.ts",
    ".storybook/**/*",
    "apps",
    "docs",
    "packages",
    "templates",
    "scripts"
  ],
  "exclude": [
    "node_modules",
    "**/dist",
    "packages/*/package",
    "scripts/spike/baseline/fixtures",
    "scripts/spike/baseline/runs",
    "scripts/spike/baseline/app"
  ]
}
