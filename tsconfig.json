{
  "extends": "./tsconfig.build.json",
  "compilerOptions": {
    "allowImportingTsExtensions": true
  },
  "include": [
    ".config/*.ts",
    ".config/*.tsx",
    "*.config.ts",
    ".storybook/**/*",
    "apps",
    "packages",
    "templates"
  ],
  "exclude": [
    "node_modules",
    "**/dist",
    "packages/*/package",
    "packages/tools/test-fixtures"
  ]
}
