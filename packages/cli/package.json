{
  "name": "@pentaho/uikit-cli",
  "version": "7.0.2",
  "private": true,
  "type": "module",
  "author": "UI Kit Team",
  "description": "The UI Kit CLI: create apps and Pentaho plugins, and package plugins for a Pentaho server.",
  "homepage": "https://github.com/pentaho/hv-uikit-react",
  "license": "Apache-2.0",
  "bin": {
    "uikit-cli": "./dist/index.js"
  },
  "keywords": [
    "uikit-cli",
    "cli"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/pentaho/hv-uikit-react.git",
    "directory": "packages/cli"
  },
  "bugs": {
    "url": "https://github.com/pentaho/hv-uikit-react/issues"
  },
  "scripts": {
    "build": "rimraf dist && tsc && node -e \"fs.chmodSync('dist/index.js', 0o755)\"",
    "dev": "tsc --watch",
    "pretest": "tsc && tsc -p evals",
    "test": "vitest --project cli",
    "test:apps": "tsc && vitest run --project apps",
    "test:e2e": "node scripts/e2e-outside-repo.ts",
    "clean": "rimraf dist templates",
    "prepublishOnly": "npm run build",
    "prepack": "node scripts/pack-templates.ts"
  },
  "dependencies": {
    "@inquirer/prompts": "^8.8.0",
    "commander": "^15.1.0",
    "fflate": "^0.8.3",
    "zod": "^4.6.7"
  },
  "engines": {
    "node": "^22.22.2 || ^24.15.0 || >=26.0.0"
  },
  "files": [
    "dist",
    "templates"
  ],
  "publishConfig": {
    "access": "public"
  },
  "peerDependencies": {
    "playwright": ">=1.50.0"
  },
  "peerDependenciesMeta": {
    "playwright": {
      "optional": true
    }
  }
}
