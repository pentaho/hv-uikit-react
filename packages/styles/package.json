{
  "name": "@pentaho/uikit-styles",
  "version": "7.0.0",
  "type": "module",
  "private": false,
  "author": "UI Kit Team",
  "description": "UI Kit styling solution.",
  "homepage": "https://github.com/pentaho/hv-uikit-react",
  "sideEffects": false,
  "keywords": [
    "design-system",
    "ui-kit",
    "typescript"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/pentaho/hv-uikit-react.git",
    "directory": "packages/styles"
  },
  "license": "Apache-2.0",
  "bugs": {
    "url": "https://github.com/pentaho/hv-uikit-react/issues"
  },
  "scripts": {
    "build": "vite build && npm run extract:tokens",
    "test": "vitest",
    "clean": "rimraf dist",
    "prepublishOnly": "npm run build",
    "extract:tokens": "node scripts/extract-tokens.ts"
  },
  "dependencies": {
    "csstype": "^3.1.3"
  },
  "devDependencies": {
    "@emotion/serialize": "^1.3.1"
  },
  "files": [
    "dist"
  ],
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "@uikit/source": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./tokens/*": "./dist/dtcg/*",
    "./package.json": "./package.json"
  },
  "publishConfig": {
    "access": "public"
  }
}
