{
  "name": "@pentaho/uikit-tools",
  "version": "1.0.0",
  "description": "CLI tools for HV UI Kit consumers: init (generate AGENTS.md), validate (check contracts), mcp (serve component metadata over MCP)",
  "license": "Apache-2.0",
  "type": "module",
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "types": "./dist/index.d.ts"
    },
    "./commands/*": {
      "import": "./dist/commands/*.js",
      "types": "./dist/commands/*.d.ts"
    }
  },
  "bin": {
    "uikit-tools": "./dist/cli.js"
  },
  "scripts": {
    "build": "tsc",
    "dev": "tsc --watch",
    "test": "vitest",
    "clean": "rimraf dist",
    "validate": "node dist/cli.js validate"
  },
  "dependencies": {
    "@pentaho/uikit-react-core": "workspace:*",
    "commander": "^11.1.0",
    "chalk": "^5.3.0",
    "glob": "^10.3.0",
    "ts-morph": "^20.0.0"
  },
  "devDependencies": {
    "@types/node": "^20.0.0",
    "typescript": "^5.3.0",
    "vitest": "^1.0.0",
    "rimraf": "^5.0.0"
  },
  "files": [
    "dist"
  ],
  "engines": {
    "node": ">=18"
  }
}
