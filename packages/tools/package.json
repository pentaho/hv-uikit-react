{
  "name": "@pentaho/uikit-tools",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "author": "UI Kit Team",
  "description": "UI Kit tools for coding agents: component, token and design rule lookups (CLI and MCP), the design rules as lint, and agent setup.",
  "homepage": "https://github.com/pentaho/hv-uikit-react",
  "license": "Apache-2.0",
  "bin": {
    "uikit-tools": "./dist/cli.js"
  },
  "keywords": [
    "uikit-tools",
    "oxlint",
    "mcp"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/pentaho/hv-uikit-react.git",
    "directory": "packages/tools"
  },
  "bugs": {
    "url": "https://github.com/pentaho/hv-uikit-react/issues"
  },
  "scripts": {
    "build": "rimraf dist && tsc && node -e \"fs.chmodSync('dist/cli.js', 0o755)\"",
    "pretest": "tsc",
    "test": "vitest",
    "test:e2e": "node scripts/e2e-outside-repo.ts",
    "clean": "rimraf dist",
    "prepublishOnly": "npm run build"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.32.1",
    "commander": "^15.1.0",
    "oxlint": "~1.63.0",
    "zod": "^3.25.76"
  },
  "peerDependencies": {
    "@pentaho/uikit-react-core": "^7.0.0"
  },
  "engines": {
    "node": "^22.22.2 || ^24.15.0 || >=26.0.0"
  },
  "files": [
    "dist",
    "rules",
    "skills",
    "oxlint.json",
    "oxlint.cli.json"
  ],
  "exports": {
    "./lint": {
      "types": "./dist/lint/plugin.d.ts",
      "default": "./dist/lint/plugin.js"
    },
    "./oxlint.json": "./oxlint.json",
    "./package.json": "./package.json"
  },
  "publishConfig": {
    "access": "public"
  }
}
