{
  "$schema": "https://raw.githubusercontent.com/oxc-project/oxc/refs/tags/oxlint_v1.63.0/npm/oxlint/configuration_schema.json",
  // The UI Kit design rules lint can check. Add this file to "extends" after your other presets.
  // Needs oxlint 1.63 or later (JS plugins). `npx --no-install uikit-tools rule <id>` explains each rule a comment names.
  "plugins": ["jsx-a11y"],
  "jsPlugins": ["@pentaho/uikit-tools/lint"],
  "rules": {
    // rule anti-patterns/prefer-ui-kit-components, tokens/colors, tokens/spacing, tokens/classes-and-css
    "uikit/raw-elements": "error",
    "uikit/no-inline-style": "error",
    "uikit/no-raw-graphics": "error",
    "uikit/no-escape-hatches": "error",
    "uikit/no-hardcoded-values": "error",
    "uikit/theme-sizes": "error",
    "uikit/no-arbitrary-utilities": "error",
    "uikit/deprecated": "error",

    // rule components/imports
    "uikit/internal-imports": "error",

    // rule accessibility/rules-of-aria
    "uikit/clickable-elements": "error",
    "uikit/icon-button-label": "error",
    "uikit/tag-label": "error",
    "uikit/control-names": "error",
    "jsx-a11y/aria-props": "error",
    "jsx-a11y/aria-proptypes": "error",
    "jsx-a11y/aria-role": "error",
    "jsx-a11y/aria-unsupported-elements": "error",
    "jsx-a11y/role-supports-aria-props": "error",
    "jsx-a11y/interactive-supports-focus": "error",
    "jsx-a11y/no-aria-hidden-on-focusable": "error",
    "jsx-a11y/alt-text": "error",
    "jsx-a11y/anchor-has-content": "error",
    "jsx-a11y/heading-has-content": "error",
    "jsx-a11y/iframe-has-title": "error"
  },
  // as the UI Kit's own config reads its components: `component="a"` makes the element an `a`
  "settings": {
    "jsx-a11y": {
      "polymorphicPropName": "component",
      "components": { "HvButton": "button", "HvButtonBase": "button" }
    }
  },
  // tests and stories render bare markup and fixed values on purpose; what they import still counts
  "overrides": [
    {
      "files": ["**/*.{test,spec,stories}.{ts,tsx}", "**/tests/**"],
      "rules": {
        "uikit/raw-elements": "off",
        "uikit/no-inline-style": "off",
        "uikit/no-raw-graphics": "off",
        "uikit/no-escape-hatches": "off",
        "uikit/no-hardcoded-values": "off",
        "uikit/theme-sizes": "off",
        "uikit/no-arbitrary-utilities": "off",
        "uikit/clickable-elements": "off",
        "uikit/icon-button-label": "off",
        "uikit/tag-label": "off",
        "uikit/control-names": "off"
      }
    }
  ]
}
