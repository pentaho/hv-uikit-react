{
  "extends": "@pentaho/uikit-config/tsconfig",
  "compilerOptions": {
    "module": "nodenext",
    "lib": ["ES2023"],
    "types": ["node"],
    "verbatimModuleSyntax": true,
    "noEmit": false,
    "declaration": true,
    "outDir": "./dist",
    "rootDir": "./src"
  },
  "include": ["src"],
  "exclude": ["src/**/*.test.ts"]
}
